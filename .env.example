# Copia este archivo como .env y rellena los valores. El archivo .env NUNCA se sube al repositorio.
# Sin ninguna variable la web arranca en MODO PRUEBA: pasarela de pago simulada (no cobra)
# y correos guardados en la bandeja de pruebas (no se envían).

# --- General -----------------------------------------------------------------
# development | production
NODE_ENV=development
PORT=3000
# Dirección pública con https en producción (enlaces de los correos, pagos y SEO).
BASE_URL=http://localhost:3000
# Secreto para firmar enlaces y tokens (mínimo 32 caracteres; obligatorio en producción).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=
# Pon 1 si la web está detrás de un proxy (Render, Railway, Nginx…).
TRUST_PROXY=0

# --- Datos -------------------------------------------------------------------
DATABASE_FILE=./data/frame.db
UPLOADS_DIR=./uploads

# --- Primer usuario del panel (/admin) -----------------------------------------
# En producción, si no se indican, se crea admin@frame.local con una contraseña aleatoria
# que se muestra una sola vez en el registro del servidor. Se pide cambiarla al entrar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Correo (SMTP) -------------------------------------------------------------
# Sin SMTP_HOST los correos NO se envían: se guardan en /admin/correos y en /correo-prueba.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FRAME <frame@gmail.com>"
# Dirección que recibe los avisos de nuevas solicitudes.
NOTIFY_TO=frame@gmail.com

# --- Pagos con Stripe ----------------------------------------------------------
# Con las dos claves se usa Stripe Checkout (las claves sk_test_ son de modo prueba de Stripe).
# Webhook en Stripe: {BASE_URL}/webhooks/stripe con los eventos
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, payment_intent.payment_failed
# y charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Solo para demostraciones en un servidor -----------------------------------
# En producción la pasarela simulada y la bandeja de pruebas están desactivadas.
# Actívalas solo en una copia de demostración, nunca en la web real.
ALLOW_TEST_GATEWAY=false
DEMO_MAILBOX=false
